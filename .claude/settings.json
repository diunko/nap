{
  "permissions": {
    "allow": [
      "Edit",
      "Write(src/**)",
      "Write(tests/**)",
      "Write(.napkins/**)",
      "Write(package.json)",
      "Write(tsconfig*.json)",
      "Write(vitest.config.*)",
      "Write(playwright.config.*)",
      "Write(electron.vite.config.*)",
      "Bash(npm install*)",
      "Bash(npm run*)",
      "Bash(npm test*)",
      "Bash(npx tsc*)",
      "Bash(npx vitest*)",
      "Bash(npx playwright*)",
      "Bash(mkdir -p *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(nap3 *)",
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "nap3 hook permission-request"
          }
        ]
      }
    ]
  }
}