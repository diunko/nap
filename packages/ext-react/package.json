    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
